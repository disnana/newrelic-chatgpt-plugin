# SiteのSecretsに設定する環境変数名。実際の値はここに記入しない。
NEW_RELIC_TOKEN_ENCRYPTION_KEY=
# Optional reviewed schema-pinned policies; default empty denies all generic execution.
NEW_RELIC_MCP_POLICIES={}
# Core, Advanced and Preview usage permissions default off and are managed per user in the Site.
# Default identity mode for an owner-only ChatGPT Site. Do not enable signed_proxy without a reviewed gateway.
NEW_RELIC_AUTH_MODE=sites
# Optional signed_proxy verifier settings. Keep empty unless a trusted gateway injects short-lived RS256 assertions.
NEW_RELIC_AUTH_JWT_PUBLIC_KEY=
NEW_RELIC_AUTH_JWT_KID=
NEW_RELIC_AUTH_ISSUER=
NEW_RELIC_AUTH_AUDIENCE=
# Set an explicit JSON allowlist; the empty placeholder denies signed_proxy authentication.
NEW_RELIC_AUTH_ALLOWED_SUBJECTS=[]
NEW_RELIC_AUTH_ALLOWED_ORIGIN=
# Explicitly disabled. No reviewed write/destructive provider policies are shipped.
NEW_RELIC_OPERATION_APPROVALS_ENABLED=false
